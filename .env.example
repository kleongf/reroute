# Copy to .env and fill in. Never commit .env.
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id
RETELL_FROM_NUMBER=+15555550100
# Dedicated tracer Agent only; --setup prints its ID. Do not use the fleet Agent.
RETELL_TRACER_AGENT_ID=
# Consenting teammate's US E.164 number; only used with an explicit --call.
RETELL_TO_NUMBER=
# Public tunnel URL (cloudflared/ngrok) that Retell will call back.
PUBLIC_BASE_URL=https://example.trycloudflare.com
PORT=3000
# Optional: SQLite file path (default reroute.db). Use :memory: for throwaway runs.
DATABASE_PATH=reroute.db
# Optional ETAs from a routing service: off (default), osrm, or tomtom (live traffic).
# ROUTING=tomtom
# Free key, no card: https://developer.tomtom.com/ → sign up → dashboard → API Keys.
TOMTOM_API_KEY=your-tomtom-api-key
# Real Driver phones and Dispatcher phone from docs/specs/contracts.md.
# Blank means no real number configured; never commit phone numbers.
DRIVER_PHONE_ALEX=
DRIVER_PHONE_CASEY=
DISPATCHER_PHONE=
