# Copy to .env and fill in. Never commit .env.
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id
RETELL_FROM_NUMBER=+15555550100
# Public tunnel URL (cloudflared/ngrok) that Retell will call back.
PUBLIC_BASE_URL=https://example.trycloudflare.com
PORT=3000
# Optional: SQLite file path (default reroute.db). Use :memory: for throwaway runs.
DATABASE_PATH=reroute.db
# Offline by default. Set retell only with the fleet agent and demo phones configured.
VOICE_MODE=fake
# Optional per-kind fleet agents, falling back to RETELL_AGENT_ID.
# RETELL_AGENT_OFFER=
# RETELL_AGENT_AT_RISK_CHECK=
# RETELL_AGENT_RELEASE=
# RETELL_AGENT_ESCALATION=
DRIVER_PHONE_ALEX=
DRIVER_PHONE_CASEY=
DISPATCHER_PHONE=
