{
  "name": "reroute",
  "version": "0.0.0",
  "private": true,
  "description": "Reroute: voice-first fleet dispatcher (hackathon)",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter @reroute/web dev",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && pnpm --filter @reroute/web build",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p public/tsconfig.json && pnpm --filter @reroute/web typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "tsx scripts/verify.ts",
    "ui:explore": "tsx scripts/explore.ts",
    "retell:tracer": "node --env-file-if-exists=.env scripts/retell-tracer.ts",
    "retell:export": "node --env-file-if-exists=.env scripts/retell-export.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
